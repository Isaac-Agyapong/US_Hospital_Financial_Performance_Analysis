	partition hospital_year = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "hospital_year.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ccn", type text}, {"fiscal_year", Int64.Type}, {"state_abbrev", type text}, {"hospital_type", type text}, {"ownership", type text}, {"rural_urban", type text}, {"medicaid_status", type text}, {"total_revenue", type number}, {"net_income", type number}, {"total_margin", type number}, {"loss", Int64.Type}, {"has_prior", Int64.Type}, {"stressed", Int64.Type}, {"group_label", type text}, {"loss_streak", Int64.Type}, {"medicaid_fifth", Int64.Type}, {"medicaid_fifth_label", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
