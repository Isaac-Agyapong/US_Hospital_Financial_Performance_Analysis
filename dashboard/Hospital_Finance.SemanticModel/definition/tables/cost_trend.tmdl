	partition cost_trend = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "cost_trend.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"fiscal_year", Int64.Type}, {"cost_per_stay", type number}, {"agency_staff_share", type number}, {"charge_to_cost", type number}, {"us_billed_per_dollar", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
