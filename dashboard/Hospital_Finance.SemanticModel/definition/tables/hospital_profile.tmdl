	partition hospital_profile = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "hospital_profile.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"ccn", type text}, {"hospital_name", type text}, {"city", type text}, {"state_abbrev", type text}, {"state_name", type text}, {"hospital_type", type text}, {"ownership", type text}, {"rural_urban", type text}, {"beds", Int64.Type}, {"last_year", Int64.Type}, {"last_margin", type number}, {"last_net_income", type number}, {"last_revenue", type number}, {"loss_years", Int64.Type}, {"loss_band", type text}, {"loss_band_order", Int64.Type}, {"hospital_label", type text}, {"state_rank", Int64.Type}, {"state_peers", Int64.Type}, {"state_median_margin", type number}, {"us_median_margin", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
