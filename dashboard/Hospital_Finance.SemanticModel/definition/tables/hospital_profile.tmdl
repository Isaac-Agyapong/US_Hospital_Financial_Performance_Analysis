table hospital_profile
	lineageTag: cccdb2d4-96ab-5c55-8680-270be4925ac2

	measure 'Profile Name' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), SELECTEDVALUE ( hospital_profile[hospital_name] ), "Pick a hospital" )
		displayFolder: Hospital
		lineageTag: 3062ecc4-a1ab-51dd-bdda-c1d78fbf4ae3

	measure 'Profile Facts' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), SELECTEDVALUE ( hospital_profile[hospital_type] ) & "   ·   " & SELECTEDVALUE ( hospital_profile[ownership] ) & "   ·   " & SELECTEDVALUE ( hospital_profile[rural_urban] ) & "   ·   " & SELECTEDVALUE ( hospital_profile[city] ) & ", " & SELECTEDVALUE ( hospital_profile[state_name] ) & "   ·   " & FORMAT ( SUM ( hospital_profile[beds] ), "#,0" ) & " beds", "Type a hospital name in the search box on the left" )
		displayFolder: Hospital
		lineageTag: 869ca7c0-9bf4-5e62-8450-aed0d2af379f

	measure 'Profile Margin' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), SUM ( hospital_profile[last_margin] ) )
		formatString: 0.0%
		displayFolder: Hospital
		lineageTag: e0cbd936-6fec-5e47-a9f6-30b32e341aa7

	measure 'Profile Margin Context' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), "in " & MAX ( hospital_profile[last_year] ) & "  ·  US typical " & FORMAT ( MAX ( hospital_profile[us_median_margin] ), "0.0%" ) )
		displayFolder: Hospital
		lineageTag: fbfe01ce-0e5a-5ed2-a90e-ae88c37e98e6

	measure 'Profile Margin Colour' = IF ( [Profile Margin] < 0, "#FF6B6B", "#34D399" )
		displayFolder: Hospital
		lineageTag: 63b8c553-5d25-5925-a09e-78369572b57d

	measure 'Profile Result' =
			VAR _n = SUM ( hospital_profile[last_net_income] )
			VAR _m = ABS ( _n )
			VAR _t = "$" & IF ( _m >= 1e9, FORMAT ( _m / 1e9, "0.0" ) & "B", IF ( _m >= 1e6, FORMAT ( _m / 1e6, "0.0" ) & "M", FORMAT ( _m / 1e3, "0" ) & "K" ) )
			RETURN IF ( HASONEVALUE ( hospital_profile[hospital_label] ), IF ( _n < 0, "Lost ", "Made " ) & _t )
		displayFolder: Hospital
		lineageTag: 0f9e1434-2151-5745-a04b-7ae034177f57

	measure 'Profile Result Context' =
			VAR _r = SUM ( hospital_profile[last_revenue] )
			RETURN IF ( HASONEVALUE ( hospital_profile[hospital_label] ), "on $" & IF ( _r >= 1e9, FORMAT ( _r / 1e9, "0.0" ) & "B", FORMAT ( _r / 1e6, "0" ) & "M" ) & " of revenue in " & MAX ( hospital_profile[last_year] ) )
		displayFolder: Hospital
		lineageTag: 01076b91-c695-5106-b8a1-ffff900e09da

	measure 'Profile Streak' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), SUM ( hospital_profile[loss_years] ) )
		formatString: 0
		displayFolder: Hospital
		lineageTag: 533cd11f-920b-51d8-883e-e88be24bd625

	measure 'Profile Streak Context' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), IF ( SUM ( hospital_profile[loss_years] ) = 0, "made money in its latest year", "losing money up to " & MAX ( hospital_profile[last_year] ) ) )
		displayFolder: Hospital
		lineageTag: ffa1953a-6b03-5771-934d-de546ccecb13

	measure 'Profile Streak Colour' = IF ( SUM ( hospital_profile[loss_years] ) >= 2, "#FF6B6B", "#34D399" )
		displayFolder: Hospital
		lineageTag: 0241ff52-2365-5e87-83d5-82014a53693b

	measure 'Profile Rank' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), "#" & SUM ( hospital_profile[state_rank] ) & " of " & SUM ( hospital_profile[state_peers] ) )
		displayFolder: Hospital
		lineageTag: 74ee331b-c818-5d5c-85e7-820873708553

	measure 'Profile Rank Context' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), "in " & SELECTEDVALUE ( hospital_profile[state_name] ) & " by profit margin" )
		displayFolder: Hospital
		lineageTag: 5f1c0050-2c86-58b5-b33b-90d1f805990f

	measure 'Hospital Margin' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), AVERAGE ( hospital_year[total_margin] ) )
		formatString: 0.0%
		displayFolder: Hospital
		lineageTag: c9a4cbf6-b2e6-5503-8951-2502378ca866

	measure 'Hospital Margin Colour' = IF ( [Hospital Margin] < 0, "#FF6B6B", "#34D399" )
		displayFolder: Colours
		lineageTag: 6ba0f2ff-dccc-588a-9e5f-d144d48abc52

	measure 'State Typical Margin' = IF ( HASONEVALUE ( hospital_profile[hospital_label] ), SUM ( hospital_profile[state_median_margin] ) )
		formatString: 0.0%
		displayFolder: Hospital
		lineageTag: 295fbf12-e415-5410-952b-ffced975a675

	measure 'Gauge Min' = -0.2
		formatString: 0%
		displayFolder: Hospital
		lineageTag: cf235b8c-983d-53ab-a9ba-01f4e98a8eeb

	measure 'Gauge Max' = 0.3
		formatString: 0%
		displayFolder: Hospital
		lineageTag: 8815747e-1874-5ad7-8305-efa700e0c51a

	measure 'Profile Sentence' =
			VAR _m = SUM ( hospital_profile[last_margin] )
			VAR _s = SUM ( hospital_profile[state_median_margin] )
			VAR _k = SUM ( hospital_profile[loss_years] )
			RETURN IF ( HASONEVALUE ( hospital_profile[hospital_label] ),
			    "In " & MAX ( hospital_profile[last_year] ) & ", this hospital " & IF ( _m < 0, "lost ", "kept " ) & FORMAT ( ABS ( _m ) * 100, "0.0" )
			        & " cents on every dollar it took in" & IF ( _m < 0, "", " as profit" ) & ". That is "
			        & IF ( _m > _s + 0.005, "better than", IF ( _m < _s - 0.005, "worse than", "about the same as" ) )
			        & " the typical hospital in " & SELECTEDVALUE ( hospital_profile[state_name] ) & " (" & FORMAT ( _s * 100, "0.0" ) & " cents). "
			        & SWITCH ( TRUE (), _k >= 3, "It has lost money " & _k & " years in a row: a sign of lasting financial stress.",
			                            _k = 2, "It has lost money two years in a row, which this report counts as financial stress.",
			                            _k = 1, "It lost money in its latest year only.",
			                            "It made money in its latest year." ),
			    "Pick a hospital in the search box to see what its numbers mean." )
		displayFolder: Hospital
		lineageTag: 826e0dc0-8b11-57e5-99d1-6d73e5b09b10

