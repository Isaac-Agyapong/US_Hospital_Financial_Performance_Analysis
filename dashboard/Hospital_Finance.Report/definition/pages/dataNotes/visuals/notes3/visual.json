    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Keep in mind",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#FF6B6B",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Hospitals in a health system often hold little cash of their own, so cash is not used to judge them",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Reports shorter than 300 days (openings, closures, owner changes) and impossible margins (over 100%) are left out",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  A hospital's fiscal year may not match the calendar year",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Maryland sets hospital prices by law, so its billed vs paid numbers are not comparable",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  COVID relief money counts as income, which lifted 2020 and 2021 margins",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Rural means outside a metro area. Some city hospitals are paid by Medicare as if rural; here they count as urban",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
