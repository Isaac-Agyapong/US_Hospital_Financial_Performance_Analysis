                  {
                    "value": "Words used here",
                    "textStyle": {
                      "fontSize": "15pt",
                      "color": "#34D399",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Profit margin: the share of each dollar of income a hospital keeps after paying its costs (all income, including investments and donations)",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Losing money: costs were higher than income for the year",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Financial stress: lost money two years in a row",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Typical: the middle hospital (median), so a few very large hospitals do not skew it",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Critical access hospital: a small rural hospital (25 beds or fewer) that Medicare pays based on its costs",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "•  Unpaid care: free (charity) care plus bills patients never paid",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#EEF4F3"
                    }
                  }
                ]
              }
            ]
          }
